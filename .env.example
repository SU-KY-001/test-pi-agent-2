# API
API_PORT=3001
LOG_LEVEL=debug

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# PGlite
PGLITE_DATA_DIR=./packages/db/data/pgdata

# --- Pi AI Model Provider Setup ---
# Tuỳ chọn 1: Dùng trực tiếp Google AI Studio (Gemini)
PI_PROVIDER=google
GEMINI_API_KEY=your-gemini-api-key
PI_MODEL=gemini-2.5-flash

# Tuỳ chọn 2: Dùng OpenCode Go
# PI_PROVIDER=opencode-go
# OPENCODE_API_KEY=your-opencode-api-key
# PI_MODEL=minimax-m3
# OPENCODE_MODEL=minimax-m3

PI_THINKING_LEVEL=medium
